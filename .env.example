# =============================================================================
# AgriSure Platform - Environment Configuration Example
# =============================================================================

# Django Security
SECRET_KEY=django-insecure-replace-this-in-production-with-a-cryptographically-strong-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.agrisure.in

# Database Configuration
# SQLite for local development:
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL for production:
# DATABASE_URL=postgres://agrisure_user:agrisure_password@localhost:5432/agrisure_db

# Razorpay Payment Gateway
# Obtain test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId12345
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere123
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretSigningTokenHere123

# Email Delivery Configuration (Console backend default for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@agrisure.in
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=AgriSure Platform <notifications@agrisure.in>

# Redis & Celery Asynchronous Queue (Optional for development, recommended in production)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Production SSL & Security Settings (Auto-enabled when DEBUG=False)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
